APP_HOST=localhost
APP_ENDPOINT_V=v1
APP_ENVIRONMENT=development
APP_PORT=8080
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ACCESS_TOKEN_MINS=60

# Database Configuration
# Get your Supabase connection string from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/database
DB_POSTGRES_DSN=postgresql://user:password@host:port/database
DB_POSTGRES_SCHEMA=public
DB_POSTGRES_MAX_IDLE_CONNS=10
DB_POSTGRES_MAX_OPEN_CONNS=100
DB_POSTGRES_MAX_LIFE_TIME=5m
DB_POSTGRES_TIMEOUT=10s
